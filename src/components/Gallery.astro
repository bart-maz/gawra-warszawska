---
import { Image } from "astro:assets";
interface Props { images: ImageMetadata[]; title: string; }
const { images, title } = Astro.props;
---
<ul class="gallery">
  {images.map((img, i) => (
    <li><Image src={img} alt={`${title}, zdjęcie ${i + 2}`} widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 50vw" quality={70} loading="lazy" /></li>
  ))}
</ul>
<style>
  .gallery { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  li { aspect-ratio: 3 / 2; overflow: hidden; background: var(--ink); }
  li:nth-child(3n + 1) { grid-column: 1 / -1; aspect-ratio: 2 / 1; }
  li:last-child:nth-child(3n + 2) { grid-column: 1 / -1; aspect-ratio: 2 / 1; }
  img { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 760px) { .gallery { grid-template-columns: 1fr; } li, li:nth-child(n) { aspect-ratio: 3 / 2; } }
</style>
