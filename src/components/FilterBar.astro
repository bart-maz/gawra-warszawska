---
import type { Project } from "../lib/collection";
import { SERVICES, TYPES } from "../lib/taxonomy";

interface Props { projects: Project[]; }
const { projects } = Astro.props;
const clients = [...new Map(projects.map((p) => [p.clientSlug, p.data.client])).entries()].sort((a, b) => a[1].localeCompare(b[1], "pl"));
---
<div class="filters" id="filters" data-clients={clients.map((c) => c[0]).join(" ")}>
  <div class="types" role="group" aria-label="Typ wydarzenia">
    <button type="button" data-filter="typ" data-value="" aria-pressed="true">Wszystkie</button>
    {Object.entries(TYPES).map(([slug, label]) => (
      <button type="button" data-filter="typ" data-value={slug} aria-pressed="false">{label}</button>
    ))}
  </div>
  <div class="selects">
    <label for="f-klient">Klient
      <select id="f-klient">
        <option value="">Wszyscy</option>
        {clients.map(([slug, name]) => <option value={slug}>{name}</option>)}
      </select>
    </label>
    <label for="f-usluga">Usługa
      <select id="f-usluga">
        <option value="">Wszystkie</option>
        {Object.entries(SERVICES).map(([slug, label]) => <option value={slug}>{label}</option>)}
      </select>
    </label>
  </div>
</div>
<noscript><style>#filters { display: none; }</style></noscript>
<style>
  .filters { display: flex; flex-wrap: wrap; gap: 16px 32px; align-items: end; justify-content: space-between; }
  .types { display: flex; flex-wrap: wrap; gap: 8px; }
  button { font: inherit; font-size: 15px; font-weight: 700; color: var(--soft); background: none; border: 0; box-shadow: inset 0 0 0 1px #44444a; padding: 10px 16px; cursor: pointer; transition: background 0.15s, color 0.15s; }
  button:hover { color: var(--white); box-shadow: inset 0 0 0 1px var(--white); }
  button[aria-pressed="true"] { background: var(--red); color: var(--white); box-shadow: none; }
  .selects { display: flex; flex-wrap: wrap; gap: 12px 20px; }
  label { display: grid; gap: 4px; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--grey); }
  select { font: inherit; font-size: 15px; font-weight: 500; letter-spacing: 0; text-transform: none; color: var(--white); background: var(--ink); border: 1px solid #44444a; border-radius: 0; padding: 9px 12px; min-width: 170px; }
</style>
